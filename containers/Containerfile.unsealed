# syntax=docker/dockerfile:1
FROM quay.io/fedora/fedora-bootc:45 AS builder

# Rimuoviamo componenti di gestione boot non necessari per BIOS legacy se presenti
RUN if rpm -q bootupd >/dev/null 2>&1; then \
      dnf remove -y bootupd; \
    fi

RUN if rpm -q dnf5 >/dev/null 2>&1; then \
      dnf remove -y --setopt=protected_packages= dnf5; \
    fi

# Pulizia log e cache per alleggerire l'HDD meccanico
RUN rm -rf \
      /var/cache/dnf \
      /var/cache/libdnf5 \
      /var/cache/ldconfig/aux-cache \
      /var/log/dnf5.log \
      /var/log/* \
      /run/dnf \
      /run/selinux-policy \
      /var/lib/dnf/repos \
      /etc/selinux/targeted/previous && \
    find /run /tmp -mindepth 1 -delete 2>/dev/null || true

RUN bootc container lint --fatal-warnings

FROM scratch
COPY --from=builder / /
LABEL containers.bootc=1
LABEL ostree.bootable=1
LABEL org.opencontainers.image.title="fedora-bootc-legacy-intel-os"
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
